generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int        @id @default(autoincrement())
  name               String     @db.VarChar(100)
  email              String     @unique @db.VarChar(255)
  companyName        String?    @db.VarChar(150)
  emailVerified      DateTime?  @db.DateTime(0)
  passwordHash       String?    @db.VarChar(255)
  role               Role       @default(affiliate)
  languagePreference String     @default("en") @db.VarChar(10)
  currencyCode       String     @default("TRY") @db.Char(3)
  createdAt          DateTime   @default(now()) @db.DateTime(0)
  bankName           String?    @db.VarChar(100)
  iban               String?    @db.VarChar(34)
  phoneNumber        String?    @db.VarChar(25)
  image              String?    @db.Text
  status             Userstatus @default(pending)
  failedAttempts     Int        @default(0)
  lockUntil          DateTime?
  isFlagged          Boolean    @default(false)
  flagReason         String?    @db.VarChar(255)
  realUserFullname   String?    @db.VarChar(100)
  termsAccepted      Boolean    @default(false)

  activationToken          String?              @db.VarChar(255)
  activationRequestedCount Int                  @default(0)
  lastActivationRequestAt  DateTime?
  passwordResetTokens      PasswordResetToken[]

  salesAsMerchant    AffiliateUserSale[] @relation("AffiliateUserSale_merchantIdToUsers")
  salesAsAffiliate   AffiliateUserSale[] @relation("AffiliateUserSale_userIdToUsers")
  affiliateLinks     AffiliateLink[]
  contactMessages    ContactMessage[]
  merchantProducts   MerchantProduct[]   @relation("MerchantProducts")
  notifications      Notification[]
  payoutRequestItems PayoutRequestItem[]
  payoutRequests     PayoutRequest[]
  accounts           Account[]
  sessions           Session[]

  // 👇 Opsiyonel back-relations (raporlama/sorgu için güzel)
  webhookLogsAsMerchant  WebhookRequestLog[]   @relation("WebhookLogMerchant")
  webhookLogsAsAffiliate WebhookRequestLog[]   @relation("WebhookLogAffiliate")
  MerchantIntegration    MerchantIntegration[]

  @@index([activationToken, status])
  @@index([role, companyName]) // admin panelde arama/filtre kolaylığı (opsiyonel)
  @@map("users")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique // <— tekil
  used      Boolean  @default(false)
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, used]) // aktif/temizleme sorguları hızlı
  @@index([expiresAt]) // cron temizliği kolay
  @@map("password_reset_tokens")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?
  oauthTokenSecret  String? @db.Text
  oauthToken        String? @db.Text
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @db.VarChar(255)
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @db.VarChar(255)
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AffiliateLink {
  linkId    Int @id @default(autoincrement())
  userId    Int
  productId Int

  // Uygulama 8 byte -> 16 hex üretse de ileride esneme payı için 64
  token String @unique @db.VarChar(64)

  createdAt DateTime  @default(now()) @db.DateTime(0)
  isVisible Boolean   @default(true)
  expiresAt DateTime?

  // İlişkiler
  affiliateUserSales AffiliateUserSale[] @relation("LinkSales")
  product            MerchantProduct     @relation(fields: [productId], references: [productId])
  user               User                @relation(fields: [userId], references: [id])
  clicks             Click[]

  // Aynı user aynı ürünü bir kez “sahiplenebilsin”
  @@unique([userId, productId], map: "uniq_user_product_link")
  // Sık sorgular
  @@index([userId])
  @@index([productId])
  @@index([expiresAt])
  @@map("affiliateLinks")
}

model AffiliateUserSale {
  saleId              Int                     @id @default(autoincrement())
  orderId             String                  @db.VarChar(100)
  userId              Int
  merchantId          Int
  productId           Int
  amount              Decimal                 @db.Decimal(19, 4)
  quantity            Int                     @default(1)
  commissionAffiliate Decimal                 @db.Decimal(19, 4)
  commissionPlatform  Decimal                 @db.Decimal(19, 4)
  status              AffiliateUserSalestatus @default(pending)
  convertedAt         DateTime                @default(now()) @db.DateTime(0)
  payoutItemId        Int?
  updatedAt           DateTime?               @default(now()) @db.DateTime(0)
  affiliateLinkId     Int?
  webhookLogId        Int?

  affiliateLink     AffiliateLink?     @relation("LinkSales", fields: [affiliateLinkId], references: [linkId])
  merchantProduct   MerchantProduct    @relation(fields: [productId], references: [productId], map: "AffiliateUserSale_ibfk_2")
  merchant          User               @relation("AffiliateUserSale_merchantIdToUsers", fields: [merchantId], references: [id], map: "AffiliateUserSale_ibfk_merchant")
  affiliate         User               @relation("AffiliateUserSale_userIdToUsers", fields: [userId], references: [id], map: "AffiliateUserSale_ibfk_user")
  webhookRequestLog WebhookRequestLog? @relation("WebhookToSales", fields: [webhookLogId], references: [id])
  platformEarnings  PlatformEarning[]

  @@unique([orderId, productId], map: "order_product_unique")
  @@index([userId])
  @@index([merchantId])
  @@index([productId])
  @@index([payoutItemId])
  @@index([affiliateLinkId], map: "idx_affiliateLinkId")
  @@index([webhookLogId], map: "idx_webhookLogId")
  @@map("AffiliateUserSale")
}

model Click {
  clickId       Int           @id @default(autoincrement())
  linkId        Int
  ipAddress     String?       @db.VarChar(45)
  userAgent     String?       @db.Text
  referrer      String?       @db.Text
  clickedAt     DateTime      @default(now()) @db.DateTime(0)
  affiliateLink AffiliateLink @relation(fields: [linkId], references: [linkId], map: "clicks_ibfk_1")

  @@index([linkId])
  @@map("clicks")
}

model ContactMessage {
  messageId   Int      @id @default(autoincrement())
  userId      Int?
  name        String?  @db.VarChar(100)
  email       String?  @db.VarChar(255)
  message     String   @db.Text
  submittedAt DateTime @default(now()) @db.DateTime(0)
  user        User?    @relation(fields: [userId], references: [id], map: "contactMessages_ibfk_1")

  @@index([userId])
  @@map("contactMessages")
}

model MerchantProduct {
  productId          Int                 @id @default(autoincrement())
  merchantId         Int
  name               String              @db.VarChar(255)
  description        String?             @db.Text
  imageUrl           String              @db.Text
  merchantUrl        String              @db.Text
  commissionRate     Decimal             @db.Decimal(5, 2)
  isActive           Boolean             @default(true)
  totalClicks        Int                 @default(0)
  totalPurchases     Int                 @default(0)
  createdAt          DateTime            @default(now()) @db.DateTime(0)
  price              Decimal?            @default(20.00) @db.Decimal(10, 2)
  activatedByAdmin   Boolean             @default(false)
  maxSalesLimit      Int?                @default(100)
  productCode        String              @unique @db.VarChar(64)
  affiliateUserSales AffiliateUserSale[]
  affiliateLinks     AffiliateLink[]
  merchant           User                @relation("MerchantProducts", fields: [merchantId], references: [id], map: "merchantProducts_ibfk_1")
  payoutRequestItems PayoutRequestItem[]

  @@index([merchantId])
  @@map("merchantProducts")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType @default(info)
  message   String           @db.Text
  link      String?          @db.VarChar(255)
  createdAt DateTime         @default(now()) @db.DateTime(0)
  read      Boolean          @default(false)
  isDeleted Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], map: "fk_notification_user")

  @@unique([userId, link], map: "uniq_user_link") // ✅ aynı user+link tekrar yazılamaz
  @@index([userId])
  @@map("notifications")
}

model PayoutRequest {
  requestId        Int          @id @default(autoincrement())
  userId           Int
  amountTotal      Decimal      @db.Decimal(19, 4)
  status           Payoutstatus @default(pending)
  requestedAt      DateTime?    @default(now()) @db.DateTime(0)
  paidAt           DateTime?    @db.DateTime(0)
  bankName         String?      @db.VarChar(100)
  iban             String?      @db.VarChar(34)
  platformPaid     Boolean      @default(false)
  platformPaidAt   DateTime?    @db.DateTime(0)
  realUserFullname String?      @db.VarChar(100)
  rejectedReason   String?      @db.VarChar(255)
  updatedAt        DateTime?    @default(now()) @db.DateTime(0)
  idempotencyKey   String?      @db.VarChar(100)

  payoutRequestItems PayoutRequestItem[]
  user               User                @relation(fields: [userId], references: [id], map: "payoutRequests_ibfk_1")

  @@unique([userId, idempotencyKey], map: "uniq_user_idempotencyKey")
  @@index([userId])
  @@map("payoutRequests")
}

model PayoutRequestItem {
  itemId              Int                      @id @default(autoincrement())
  requestId           Int
  merchantId          Int
  amount              Decimal                  @db.Decimal(19, 4)
  sourceSaleIds       String?                  @db.Text
  createdAt           DateTime?                @default(now()) @db.DateTime(0)
  paidAt              DateTime?                @db.DateTime(0)
  paidBy              Int?
  platformConfirmedAt DateTime?                @db.DateTime(0)
  productId           Int?
  rejectedReason      String?                  @db.VarChar(255)
  status              PayoutRequestItemstatus? @default(pending)
  transactionId       String?                  @db.VarChar(100)
  updatedAt           DateTime?                @default(now()) @db.DateTime(0)
  idempotencyKey      String?                  @db.VarChar(100)

  payoutRequest   PayoutRequest    @relation(fields: [requestId], references: [requestId], map: "payoutRequestItems_ibfk_1")
  user            User             @relation(fields: [merchantId], references: [id], map: "payoutRequestItems_ibfk_2")
  merchantProduct MerchantProduct? @relation(fields: [productId], references: [productId], onDelete: Restrict, map: "payoutRequestItems_ibfk_product")

  @@unique([merchantId, idempotencyKey], map: "uniq_merchant_idempotencyKey")
  @@index([merchantId])
  @@index([requestId])
  @@index([productId])
}

model PayoutRequestLog {
  logId     Int       @id @default(autoincrement())
  requestId Int?
  itemId    Int?
  action    String?   @db.VarChar(50)
  oldstatus String?   @db.VarChar(20)
  newstatus String?   @db.VarChar(20)
  userId    Int?
  note      String?   @db.Text
  createdAt DateTime? @default(now()) @db.DateTime(0)
}

model Currency {
  code             String            @id @db.Char(3)
  symbol           String            @db.VarChar(5)
  minorUnit        Int
  updatedAt        DateTime          @default(now()) @db.DateTime(0)
  baseRates        ExchangeRate[]    @relation("baseCurrency")
  targetRates      ExchangeRate[]    @relation("targetCurrency")
  platformEarnings PlatformEarning[]

  @@map("currencies")
}

model ExchangeRate {
  baseCurrency      String   @db.Char(3)
  targetCurrency    String   @db.Char(3)
  rate              Decimal  @db.Decimal(18, 8)
  validFrom         DateTime @db.DateTime(0)
  validTo           DateTime @db.DateTime(0)
  baseCurrencyRel   Currency @relation("baseCurrency", fields: [baseCurrency], references: [code], map: "exchange_rates_ibfk_1")
  targetCurrencyRel Currency @relation("targetCurrency", fields: [targetCurrency], references: [code], map: "exchange_rates_ibfk_2")

  @@id([baseCurrency, targetCurrency, validFrom])
  @@index([targetCurrency])
  @@map("exchange_rates")
}

model PlatformEarning {
  earningId         Int               @id @default(autoincrement())
  saleId            Int
  amount            Decimal           @db.Decimal(19, 4)
  currencyCode      String            @default("TRY") @db.Char(3)
  loggedAt          DateTime          @default(now()) @db.DateTime(0)
  affiliateUserSale AffiliateUserSale @relation(fields: [saleId], references: [saleId], map: "platform_earnings_ibfk_1")
  currency          Currency          @relation(fields: [currencyCode], references: [code], map: "platform_earnings_ibfk_2")

  @@index([currencyCode])
  @@index([saleId])
}

model PlatformConfig {
  keyName   String    @id @db.VarChar(100)
  value     String    @db.Text
  updatedAt DateTime? @default(now()) @db.DateTime(0)
}

model MerchantIntegration {
  id                 Int       @id @default(autoincrement())
  merchantId         Int
  keyId              String    @unique @db.VarChar(100)
  secretHash         String    @db.VarChar(255)
  webhookIpAllowlist String?   @db.Text
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.DateTime(0)
  rotatedAt          DateTime?

  merchant User @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model WebhookRequestLog {
  id          Int           @id @default(autoincrement())
  merchantId  Int
  affiliateId Int? // token -> AffiliateLink -> userId çözümlenirse
  requestId   String        @unique @db.VarChar(100) // X-Request-Id
  nonce       String        @unique @db.VarChar(100) // X-Nonce
  sentAt      DateTime
  receivedAt  DateTime      @default(now()) @db.DateTime(0)
  hmac        String        @db.VarChar(255) // X-Signature (geldiği gibi)
  ip          String        @db.VarChar(45)
  ua          String?       @db.Text
  status      WebhookStatus
  error       String?       @db.Text

  // İçerik (kanıt ve debug için):
  rawBody    String @db.LongText // imza doğrulaması için "aynen gelen" gövde
  headers    Json? // X-Key-Id, X-Timestamp vb.
  parsedBody Json? // { orderId, items:[{productCode, quantity, unitPrice, currency, ...}], token, ... }
  itemsCount Int?

  // 👇 İsimlendirilmiş ilişkiler (ambiguous relation fix)
  merchant  User  @relation("WebhookLogMerchant", fields: [merchantId], references: [id])
  affiliate User? @relation("WebhookLogAffiliate", fields: [affiliateId], references: [id])

  sales AffiliateUserSale[] @relation("WebhookToSales")

  @@index([merchantId])
  @@index([affiliateId])
  @@map("webhookRequestLogs")
}

// ENUMS
enum Role {
  admin
  merchant
  affiliate
}

enum Userstatus {
  pending
  active
  rejected
}

enum AffiliateUserSalestatus {
  pending
  confirmed
  rejected
}

enum Payoutstatus {
  pending
  approved
  paid
  rejected
}

enum PayoutRequestItemstatus {
  pending
  merchant_paid
  platform_confirmed
  rejected
}

enum NotificationType {
  info
  support_reply
  important
}

enum WebhookStatus {
  accepted
  invalid_signature
  replay
  expired
  invalid_product
  unauthorized
  error
}

model ApiLog {
  id        Int      @id @default(autoincrement())
  endpoint  String
  ip        String
  ua        String
  event     String
  email     String?
  error     String?
  createdAt DateTime @default(now())
}
